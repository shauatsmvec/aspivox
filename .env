VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Database Connection Placeholders ---
# These are provided for easy migration to different databases in the future.
# Uncomment and populate the relevant variables when switching databases.

# MongoDB (e.g., using Mongoose)
# MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/myDatabase?retryWrites=true&w=majority"

# PostgreSQL (e.g., using Prisma or pg)
# DATABASE_URL="postgresql://<username>:<password>@localhost:5432/myDatabase?schema=public"

# MySQL
# MYSQL_URL="mysql://<username>:<password>@localhost:3306/myDatabase"
